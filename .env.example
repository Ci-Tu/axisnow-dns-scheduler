# 复制为 .env 后按需修改；全部可选。.env 不会被提交到 Git。

# 宿主机端口
PORT=4894

# 运行用户（数据目录会被修正为这个属主）
PUID=1000
PGID=1000

# 潮汐时间段按这个时区生效
APP_TIMEZONE=Asia/Shanghai

# 可选：通过环境变量提供凭据。设置后界面上不能再修改，且不会写入 data/config.json
# AXISNOW_API_TOKEN=
# CLOUDFLARE_API_TOKEN=

# 启动时自动下载 DB-IP Lite 数据库（用于显示国旗与运营商），0 关闭
GEOIP_AUTO_DOWNLOAD=1

# 登录态保持天数
# SESSION_DAYS=180

LOG_LEVEL=INFO
